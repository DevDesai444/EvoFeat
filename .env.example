# copy to .env and fill in. .env is gitignored.

# Groq cloud API key — required for the cloud backbones in
# configs/llm/groq_*.yaml. https://console.groq.com/keys
GROQ_API_KEY=your-key-here

# When running a vLLM server locally (configs/llm/vllm_*.yaml) most setups
# don't enforce a bearer token; leaving "EMPTY" is fine.
VLLM_API_KEY=EMPTY

# Optional. If set, results are streamed to Weights & Biases; otherwise the
# logger writes results/runs/*.jsonl only.
# WANDB_API_KEY=
# WANDB_MODE=offline      # uncomment to skip the network call entirely
